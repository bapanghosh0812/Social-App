# ===========================================================================
# College Campus API — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ===========================================================================

NODE_ENV=development
PORT=5000
# Public URL of the web app (used in password-reset emails)
APP_URL=http://localhost:5173

# --- Security (REQUIRED in production) ---
# Long random string (>= 32 chars). In development one is auto-generated into
# data/.jwt_secret when this is blank.
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost,http://localhost

# --- Admin console ---
# Only these accounts can open the admin console, and they must also enter
# ADMIN_PIN (exactly 6 digits). Leave ADMIN_PIN blank to disable the console.
ADMIN_EMAILS=
ADMIN_PIN=
# Needed to change the admin PIN from inside the console (>= 12 characters).
OWNER_SECRET=

# --- Demo mode ---
# true = seed a sample campus + enable the one-tap "Try the demo" sign-in.
# Set to false for real launches; demo content is removed automatically.
DEMO_MODE=false

# --- Media storage (OPTIONAL) ---
# Leave AWS_* blank to store uploads on local disk (data/uploads).
# Provide the key pair + bucket to use S3. Use an IAM user limited to
# s3:PutObject/GetObject/DeleteObject on this bucket only.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=
# Max upload size in MB (reels). Photos/documents have lower built-in caps.
MAX_UPLOAD_MB=100

# --- Google sign-in (OPTIONAL) ---
# OAuth 2.0 Web client ID (the web app reads it from /api/auth/config).
GOOGLE_CLIENT_ID=

# --- Email (OPTIONAL, for password reset) ---
# Without SMTP in development, reset links are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=College Campus <no-reply@yourdomain.com>

# --- Live video (OPTIONAL) ---
# JSON list of WebRTC ICE servers. Add a TURN server for viewers on strict
# mobile networks, e.g.:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=
LIVE_MAX_VIEWERS=20

# --- Data location (OPTIONAL) ---
# DB_DIR=./data
# DB_PATH=./data/campus.db
# UPLOAD_DIR=./data/uploads
# PRIVATE_UPLOAD_DIR=./data/private

# --- Single-service deploy (OPTIONAL) ---
# true = the API also serves the built web app from ../client/dist
SERVE_CLIENT=false

# --- Observability (OPTIONAL) ---
LOG_LEVEL=info
SENTRY_DSN=
